<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Scene stylesheets="@../../css/transparent.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="koossa.plaasbestuur.fxml.livestock.LivestockNewEntryViewController">
    <AnchorPane styleClass="flow-pane">
      <children>
         <BorderPane AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <center>
               <HBox alignment="TOP_CENTER" spacing="10.0" BorderPane.alignment="TOP_CENTER">
                  <children>
                     <VBox alignment="TOP_RIGHT" spacing="16.0">
                        <children>
                           <Label text="%animalType">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%brand">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%race">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%location">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%birthDate">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%gender">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label text="%mother">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                        </children>
                        <padding>
                           <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                     </VBox>
                     <VBox fillWidth="false" spacing="10.0">
                        <padding>
                           <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                        <children>
                           <ChoiceBox fx:id="type_cb" prefWidth="175.0" />
                           <TextField fx:id="brand_tf" prefWidth="175.0" />
                           <ChoiceBox fx:id="race_cb" prefWidth="175.0" />
                           <ChoiceBox fx:id="location_cb" prefWidth="175.0" />
                           <DatePicker fx:id="birthDate_dp" prefWidth="175.0" />
                           <ChoiceBox fx:id="gender_cb" prefWidth="175.0" />
                           <ChoiceBox fx:id="mother_cb" prefWidth="175.0" />
                        </children>
                     </VBox>
                  </children>
               </HBox>
            </center>
            <top>
               <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="labelDecorated" text="%newEntry" textAlignment="CENTER" BorderPane.alignment="CENTER">
                  <font>
                     <Font name="System Bold" size="18.0" />
                  </font>
                  <padding>
                     <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                  </padding>
                  <BorderPane.margin>
                     <Insets bottom="10.0" />
                  </BorderPane.margin>
               </Label>
            </top>
            <bottom>
               <HBox alignment="CENTER" spacing="40.0" styleClass="flow-pane" BorderPane.alignment="CENTER">
                  <BorderPane.margin>
                     <Insets top="15.0" />
                  </BorderPane.margin>
                  <padding>
                     <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                  </padding>
                  <children>
                     <Button cancelButton="true" minHeight="35.0" minWidth="85.0" mnemonicParsing="false" onAction="#onCancel" text="%cancel">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Button>
                     <Button defaultButton="true" minHeight="35.0" minWidth="85.0" mnemonicParsing="false" onAction="#onOk" text="%ok">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Button>
                  </children>
               </HBox>
            </bottom>
         </BorderPane>
      </children></AnchorPane>
</Scene>
